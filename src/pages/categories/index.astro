---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();

const counts = new Map<string, number>();
for (const post of posts) {
	const key = post.data.category;
	counts.set(key, (counts.get(key) ?? 0) + 1);
}
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="分类" description="按分类浏览全部文章。">
	<section class="hero">
		<p class="kicker">共 {categories.length} 个分类 · {posts.length} 篇文章</p>
		<h1>分类</h1>
	</section>

	<section class="list-section" aria-labelledby="cat-title">
		<div class="section-head">
			<h2 id="cat-title">按篇数排序</h2>
			<a href="/blog/">全部文章 →</a>
		</div>
		<ul class="cat-list">
			{
				categories.map(([name, count]) => (
					<li>
						<a href={`/categories/${encodeURIComponent(name)}/`}>{name}</a>
						<span class="cat-count">{String(count).padStart(2, '0')} 篇</span>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
