---
// 深浅色切换。初值由 BaseLayout <head> 里的内联脚本先写好，避免闪白；
// 这里只负责点击切换 + 记住选择。
---

<button
	class="theme-toggle"
	type="button"
	data-theme-toggle
	aria-label="切换深浅色"
	aria-pressed="false"
	title="切换深浅色"
>
	<span aria-hidden="true">◐</span>
</button>

<script>
	const STORAGE_KEY = 'theme';
	const root = document.documentElement;

	function syncButtons(theme: string) {
		const isDark = theme === 'dark';
		const label = isDark ? '切换到浅色' : '切换到深色';
		for (const btn of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
			btn.setAttribute('aria-pressed', String(isDark));
			btn.setAttribute('aria-label', label);
			btn.setAttribute('title', label);
		}
	}

	syncButtons(root.dataset.theme ?? 'light');

	for (const btn of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
		btn.addEventListener('click', () => {
			const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			try {
				localStorage.setItem(STORAGE_KEY, next);
			} catch {
				/* 隐私模式禁用存储时忽略 */
			}
			syncButtons(next);
		});
	}
</script>
