---
import type { CollectionEntry } from 'astro:content';
import Comments from '../components/Comments.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Signature from '../components/Signature.astro';
import Toc from '../components/Toc.astro';
import { readingTime } from '../utils/reading-time';
import BaseLayout from './BaseLayout.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	post: CollectionEntry<'blog'>;
	headings?: Heading[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags } = post.data;
const minutes = readingTime(post.body ?? '');
const hasToc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length > 1;

// 正文里出现 LaTeX 才加载 KaTeX，其它文章一个字节都不多下载
const hasMath = /\$\$[\s\S]+?\$\$|\$[^$\n]+?\$|\\\(|\\\[/.test(post.body ?? '');
---

<BaseLayout title={title} description={description} math={hasMath}>
	<div class:list={['post-layout', { 'has-toc': hasToc }]}>
		<div class="post-main">
			<article class="post">
				<header class="post-header">
					<div class="post-meta">
						<FormattedDate date={pubDate} />
						<span aria-hidden="true">·</span>
						<span>{minutes} 分钟</span>
						<a class="post-category" href={`/categories/${encodeURIComponent(category)}/`}>
							{category}
						</a>
						{
							tags.length > 0 && (
								<ul class="tags">
									{tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							)
						}
					</div>
					<h1>{title}</h1>
					{description && <p class="sub">{description}</p>}
					{
						updatedDate && (
							<p class="updated">
								更新于 <FormattedDate date={updatedDate} />
							</p>
						)
					}
				</header>

				<Toc headings={headings} variant="inline" />

				<div class="prose">
					<slot />
				</div>
				<p class="post-signature">
					<Signature size="sm" />
				</p>
			</article>

			<Comments />
		</div>

		{hasToc && <div class="post-aside"><Toc headings={headings} variant="side" /></div>}
	</div>
</BaseLayout>
