---
import ActivityGrid from '../components/ActivityGrid.astro';
import PostList from '../components/PostList.astro';
import QuickLinks from '../components/QuickLinks.astro';
import Signature from '../components/Signature.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const recent = posts.slice(0, 6);
---

<BaseLayout description={SITE_DESCRIPTION}>
	<section class="home-hero">
		<div class="home-signature">
			<p class="kicker">个人博客 · 自 2026</p>
			<Signature size="xl" loop />
			<p class="home-note">关于生活和技术的思考，记录一些自己的想法和经验。</p>
		</div>

		<aside class="motto">
			<p class="motto-label"></p>
			<h1>どれだけあったら失敗じゃない？<br />僕らの人生は。</h1>
			<p class="motto-cite">——自由に向かって逃げろ。</p>
		</aside>
	</section>

	<section class="home-strip" aria-label="写作轨迹">
		<ActivityGrid posts={posts} />
		<QuickLinks posts={posts} />
	</section>

	<section class="list-section" aria-labelledby="recent-title">
		<div class="section-head">
			<h2 id="recent-title">最近更新</h2>
			<a href="/blog/">全部文章 →</a>
		</div>
		<PostList posts={recent} />
	</section>
</BaseLayout>
