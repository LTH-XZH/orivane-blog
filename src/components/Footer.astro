---
import { FOOTER_LINKS, SITE_FOOTER_NOTE, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<div class="wrap">
	<footer class="site-foot">
		<span>© {year} {SITE_TITLE} · {SITE_FOOTER_NOTE}</span>
		<span>
			{
				FOOTER_LINKS.map((link, index) => (
					<>
						{index > 0 && ' · '}
						<a
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noreferrer' : undefined}
						>
							{link.label}
						</a>
					</>
				))
			}
		</span>
	</footer>
</div>
