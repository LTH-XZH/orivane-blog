---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这个地址没有内容。">
	<section class="hero">
		<p class="kicker">404 · 找不到这一页</p>
		<h1>这里什么都没有</h1>
		<p class="lead">
			可能是链接旧了，也可能是地址敲错了一个字。<a href="/">回首页</a>，或者
			<a href="/blog/">翻翻文章</a>。
		</p>
	</section>
</BaseLayout>
