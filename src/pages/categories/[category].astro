---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const names = [...new Set(posts.map((post) => post.data.category))];

	return names.map((name) => ({
		params: { category: name },
		props: { name },
	}));
}

interface Props {
	name: string;
}

const { name } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.category === name);
---

<BaseLayout title={`分类：${name}`} description={`分类「${name}」下的全部文章。`}>
	<section class="hero">
		<p class="kicker">分类 · {posts.length} 篇</p>
		<h1>{name}</h1>
	</section>

	<section class="list-section" aria-labelledby="cat-list-title">
		<div class="section-head">
			<h2 id="cat-list-title">按时间倒序</h2>
			<a href="/categories/">全部分类 →</a>
		</div>
		<PostList posts={posts} />
	</section>
</BaseLayout>
